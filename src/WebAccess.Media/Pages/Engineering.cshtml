@page "/engineering"
@model WebAccess.Media.Pages.EngineeringModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
<!doctype html>
<html lang="zh-Hant">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>工程設定 · WebAccess Media</title>
    <style>
        * { box-sizing: border-box; }
        body { margin: 0; background: #101923; color: #eef4fa; font: 1rem/1.55 system-ui, sans-serif; }
        header { border-bottom: 1px solid #334858; }
        nav, main { max-width: 720px; margin: auto; padding: 1.25rem; }
        nav { display: flex; justify-content: space-between; }
        a { color: #9bdce6; }
        form { display: grid; gap: .9rem; background: #182633; border: 1px solid #334858; border-radius: .6rem; padding: 1.5rem; }
        label { display: grid; gap: .3rem; }
        input { width: 100%; font: inherit; color: inherit; background: #101923; border: 1px solid #617789; padding: .6rem; border-radius: .3rem; }
        small { color: #c2d2df; }
        .actions { display: flex; flex-wrap: wrap; gap: .65rem; margin-top: .45rem; }
        button { cursor: pointer; font: inherit; font-weight: 600; padding: .6rem .9rem; border: 1px solid #83ceda; border-radius: .3rem; color: #d5f4fa; background: transparent; }
        button.primary { color: #101923; background: #a5e1eb; }
        .feedback { border-left: 4px solid; padding: .6rem .9rem; background: #182633; }
        .success { color: #9de6bd; }
        .error { color: #ffc47a; }
    </style>
</head>
<body>
<header><nav><strong>WebAccess Media</strong><a href="/engineering/points">測點頁面</a><a href="/settings">日常管理</a><a href="/display">開啟顯示頁</a></nav></header>
<main>
    <h1>工程設定</h1>
    @if (Model.Feedback is string feedback)
    {
        <p class="feedback @(Model.IsSuccessful ? "success" : "error")" role="status">@feedback</p>
    }
    <form method="post" asp-page-handler="Save">
        <label>WebAccess IP 位址
            <input asp-for="Input.Ip" required placeholder="192.168.1.100" spellcheck="false">
            <small>程式會自動使用 HTTP 並加上 /WaWebService/Json。</small>
        </label>
        <label>專案名稱<input asp-for="Input.Project" required></label>
        <label>帳號<input asp-for="Input.Username" required autocomplete="username"></label>
        <label>密碼
            <input name="Input.Password" type="password" autocomplete="current-password">
            <small>使用相同連線資料時可留空，沿用已儲存的密碼。測試後儲存新設定時，請再次輸入密碼。</small>
        </label>
        <div class="actions">
            <button type="submit" asp-page-handler="Test">測試連線</button>
            <button type="submit" class="primary">儲存並開始監控</button>
        </div>
    </form>
</main>
</body>
</html>
