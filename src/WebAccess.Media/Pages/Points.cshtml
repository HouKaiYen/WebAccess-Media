@page "/engineering"
@model WebAccess.Media.Pages.PointsModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
<!doctype html>
<html lang="zh-Hant">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>工程設定 · WebAccess Media</title>
<style>
    * { box-sizing: border-box; }
    :root { color-scheme: dark; }
    body { margin: 0; background: #0d151e; color: #edf3f8; font: 1rem/1.5 system-ui, sans-serif; }
    nav { display: flex; flex-wrap: wrap; gap: .65rem; align-items: center; padding: .9rem 1.5rem; border-bottom: 1px solid #304352; background: #14202b; }
    nav strong { margin-right: auto; }
    a { color: #a7e4ef; text-decoration: none; }
    a:focus-visible, button:focus-visible, input:focus-visible { outline: 2px solid #99e3ef; outline-offset: 3px; }
    nav a, button, .action { padding: .4rem .75rem; border: 1px solid #4a6376; border-radius: .4rem; font: inherit; color: inherit; background: #172634; }
    button, .action { cursor: pointer; }
    .primary { background: #a5e1eb; color: #101923; border-color: #a5e1eb; font-weight: 650; }
    .workspace { display: grid; grid-template-columns: minmax(190px, 250px) minmax(0, 1fr); min-height: calc(100vh - 68px); }
    aside { padding: 1rem; background: #14202b; border-right: 1px solid #304352; }
    h1, h2, p { margin: 0 0 .8rem; }
    aside h2 { font-size: 1rem; margin-top: 1rem; color: #b1c2d0; }
    ul { list-style: none; margin: 0; padding: 0; }
    li a { display: block; padding: .55rem .7rem; margin: .2rem 0; border-radius: .4rem; overflow-wrap: anywhere; }
    li a:hover, [aria-current="page"] { background: #253c4d; color: white; }
    main { padding: 1.25rem; min-width: 0; }
    .editor { display: grid; grid-template-columns: minmax(0, 1fr) minmax(220px, 290px); gap: 1rem; }
    .canvas { min-height: 350px; background: #080e14; border: 1px solid #304352; border-radius: .6rem; display: grid; place-items: center; padding: 1.15rem; text-align: center; }
    .plan { position: relative; display: inline-block; max-width: 100%; cursor: crosshair; }
    .plan img { max-width: 100%; max-height: 66vh; display: block; }
    .marker { position: absolute; width: .95rem; height: .95rem; border: 2px solid white; background: #e74033; border-radius: 50%; transform: translate(-50%, -50%); pointer-events: none; }
    [hidden] { display: none !important; }
    .inspector { padding: 1rem; border: 1px solid #304352; border-radius: .6rem; background: #172634; }
    .inspector h2 { font-size: 1.1rem; }
    label { display: grid; gap: .25rem; margin-bottom: .75rem; }
    input { width: 100%; background: #101923; color: inherit; font: inherit; border: 1px solid #617789; border-radius: .35rem; padding: .38rem; }
    .coordinates { display: grid; grid-template-columns: 1fr 1fr; gap: .55rem; }
    .feedback { color: #9bdce6; }
    .muted { color: #b1c2d0; }
    .remove { margin-top: .6rem; }
    @@media (max-width: 800px) { .editor { grid-template-columns: 1fr; } }
    @@media (max-width: 560px) { .workspace { grid-template-columns: 1fr; } aside { border-right: 0; border-bottom: 1px solid #304352; } .canvas { min-height: 240px; } }
</style>
</head>
<body>
<nav><strong>WebAccess Media · 工程設定</strong><a href="/engineering/connection">WebAccess 連線</a><a href="/settings">返回日常管理</a><a href="/display">顯示頁</a></nav>
<div class="workspace">
    <aside>
        <a class="action" href="/engineering?add=true">＋ 新增測點頁面</a>
        <h2>測點頁面</h2>
        @if (Model.Plans.Length == 0)
        {
            <p class="muted">尚未建立測點頁面</p>
        }
        <ul>
        @foreach (WebAccess.Media.PointPlan plan in Model.Plans)
        {
            <li><a asp-page="Points" asp-route-selected="@plan.Point" aria-current="@(Model.Selected?.Point == plan.Point ? "page" : null)">@plan.Point</a></li>
        }
        </ul>
    </aside>
    <main>
        <h1>@(Model.Selected?.Point ?? "新增測點頁面")</h1>
        @if (Model.Feedback is string feedback)
        {
            <p class="feedback" role="status">@feedback</p>
        }
        <div class="editor">
            <div class="canvas">
                <p id="empty-plan" class="muted" hidden="@(Model.Selected is not null)">上傳平面圖後，點選圖面設定告警位置。</p>
                <div class="plan" id="plan" hidden="@(Model.Selected is null)">
                    @if (Model.Selected is WebAccess.Media.PointPlan selected)
                    {
                        <img id="image" src="/media/@selected.File" alt="測點平面圖">
                    }
                    else
                    {
                        <img id="image" alt="測點平面圖預覽">
                    }
                    <span class="marker" id="marker" style="left:@(Model.Selected?.X ?? 50)%;top:@(Model.Selected?.Y ?? 50)%"></span>
                </div>
            </div>
            <div class="inspector">
                <h2>測點與告警位置</h2>
                <form method="post" asp-page-handler="Save" enctype="multipart/form-data">
                    <label>測點 Name <input name="point" value="@Model.Selected?.Point" required maxlength="256" readonly="@(Model.Selected is not null)"></label>
                    <label>平面圖 <input name="image" id="file" type="file" accept=".png,.jpg,.jpeg" required="@(Model.Selected is null)"></label>
                    <div class="coordinates">
                        <label>水平位置 % <input id="x" name="x" type="number" min="0" max="100" value="@(Model.Selected?.X ?? 50)" required></label>
                        <label>垂直位置 % <input id="y" name="y" type="number" min="0" max="100" value="@(Model.Selected?.Y ?? 50)" required></label>
                    </div>
                    <button class="primary" type="submit">儲存設定</button>
                </form>
                @if (Model.Selected is WebAccess.Media.PointPlan current)
                {
                    <form class="remove" method="post" asp-page-handler="Remove"><button name="point" value="@current.Point">移除測點頁面</button></form>
                }
            </div>
        </div>
    </main>
</div>
<script>
const image = document.getElementById('image');
const plan = document.getElementById('plan');
const marker = document.getElementById('marker');
const x = document.getElementById('x');
const y = document.getElementById('y');
let temporaryImage = null;
function updateMarker() {
    marker.style.left = x.value + '%';
    marker.style.top = y.value + '%';
}
x.addEventListener('input', updateMarker);
y.addEventListener('input', updateMarker);
image.addEventListener('click', event => {
    const bounds = image.getBoundingClientRect();
    x.value = Math.round(100 * (event.clientX - bounds.left) / bounds.width);
    y.value = Math.round(100 * (event.clientY - bounds.top) / bounds.height);
    updateMarker();
});
document.getElementById('file').addEventListener('change', event => {
    const file = event.target.files[0];
    if (!file) return;
    if (temporaryImage) URL.revokeObjectURL(temporaryImage);
    temporaryImage = URL.createObjectURL(file);
    image.src = temporaryImage;
    plan.hidden = false;
    document.getElementById('empty-plan').hidden = true;
});
</script>
</body>
</html>
