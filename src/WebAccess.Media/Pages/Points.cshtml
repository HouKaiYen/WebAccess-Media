@page "/engineering"
@model WebAccess.Media.Pages.PointsModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    Layout = "_ManagementLayout";
    ViewData["Title"] = "工程設定";
    const int defaultCoordinate = 50;
    int initialX = Model.Selected?.X ?? defaultCoordinate;
    int initialY = Model.Selected?.Y ?? defaultCoordinate;
}

@section Styles {
<link rel="stylesheet" href="/alarm-icons.css">
<style>
    .workspace { display: grid; grid-template-columns: minmax(190px, 250px) minmax(0, 1fr); min-height: calc(100vh - 68px); }
    aside { padding: 1.15rem; background: var(--panel); border-right: 1px solid var(--line); }
    h1, h2, p { margin: 0 0 .8rem; }
    aside h2 { font-size: 1rem; margin-top: 1.15rem; }
    ul { list-style: none; margin: 0; padding: 0; }
    li a { display: block; padding: .55rem .7rem; margin: .2rem 0; border-radius: .4rem; overflow-wrap: anywhere; }
    li a:hover, li a[aria-current="page"] { background: var(--accent-soft); color: var(--accent); }
    main { padding: 1.25rem; min-width: 0; }
    .editor { display: grid; grid-template-columns: minmax(0, 1fr) minmax(220px, 290px); gap: 1rem; }
    .canvas { min-height: clamp(350px, 65vh, 620px); display: grid; align-self: start; place-items: center; padding: 1.15rem; text-align: center; background: radial-gradient(circle, #d9e3f1 1px, transparent 1px) 0 0 / 18px 18px, var(--panel); }
    .plan { position: relative; display: inline-block; max-width: 100%; cursor: crosshair; }
    .plan img { max-width: 100%; max-height: 66vh; display: block; }
    #alarm-preview { max-width: 100%; margin-bottom: .65rem; line-height: 1.2; overflow-wrap: anywhere; white-space: pre-wrap; }
    .marker { position: absolute; transform: translate(-50%, -50%); cursor: grab; touch-action: none; }
    .floor-grid, .icon-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .5rem; margin-bottom: .75rem; }
    .floor-card { display: grid; gap: .35rem; padding: .35rem; overflow: hidden; }
    .floor-entry { display: grid; align-content: start; gap: .25rem; min-width: 0; }
    .floor-delete { justify-self: end; padding: .15rem .4rem; font-size: .8rem; color: #a42c3e; }
    .floor-card img { width: 100%; aspect-ratio: 4 / 3; object-fit: contain; background: var(--background); }
    .floor-card span { text-overflow: ellipsis; overflow: hidden; white-space: nowrap; font-size: .8rem; }
    .icon-option { display: flex; align-items: center; gap: .4rem; margin: 0; padding: .35rem; border: 1px solid var(--border); border-radius: .4rem; font-size: .85rem; }
    .icon-option:has(:checked) { border-color: var(--accent); background: var(--accent-soft); }
    .check { display: flex; align-items: center; }
    .icon-option input, .check input { width: auto; margin: 0; }
    [hidden] { display: none !important; }
    .inspector { padding: 1rem; }
    .inspector h2 { font-size: 1.1rem; }
    label { display: grid; gap: .25rem; margin-bottom: .75rem; }
    .coordinates { display: grid; grid-template-columns: 1fr 1fr; gap: .55rem; }
    fieldset { border: 1px solid var(--line); border-radius: .5rem; margin: .25rem 0 1rem; padding: .7rem; min-width: 0; }
    .remove { margin-top: .6rem; }
    @@media (max-width: 800px) { .editor { grid-template-columns: 1fr; } }
    @@media (max-width: 560px) { .workspace { grid-template-columns: 1fr; } aside { border-right: 0; border-bottom: 1px solid var(--line); } .canvas { min-height: 240px; } }
    @@media (min-width: 801px) {
        body { height: 100vh; height: 100dvh; display: flex; flex-direction: column; overflow: hidden; }
        .workspace { flex: 1; min-height: 0; }
        .workspace > aside, .inspector { min-height: 0; overflow-y: auto; overscroll-behavior-y: contain; scrollbar-gutter: stable; }
        main { display: flex; flex-direction: column; min-height: 0; }
        .editor { flex: 1; min-height: 0; }
        .canvas { min-height: 0; align-self: stretch; overflow: hidden; }
        .plan > #image { max-height: 58vh; }
    }

    input { width: 100%; }
    .tag-picker { width: min(34rem, calc(100vw - 2rem)); max-height: 90vh; padding: 1rem; border: 1px solid var(--border); color: var(--text); }
    .tag-picker::backdrop { background: #17243c66; }
    .tag-picker-header { display: flex; justify-content: space-between; align-items: start; gap: .75rem; }
    .tag-picker-header h2 { font-size: 1.1rem; }
    .tag-results { display: grid; gap: .3rem; max-height: min(24rem, 50vh); overflow: auto; padding: .2rem; }
    .tag-result { display: grid; gap: .1rem; text-align: left; overflow-wrap: anywhere; }
    .tag-result:hover, .tag-result:focus-visible { background: var(--accent-soft); }
    .workspace-title, .simulation-toolbar { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: .5rem; margin-bottom: .8rem; }
    .workspace-title h1, .simulation-toolbar h2 { margin: 0; }
    .simulation-dialog { width: min(68rem, calc(100vw - 2rem)); max-height: 92vh; padding: 1rem; border: 1px solid var(--border); color: var(--text); }
    .simulation-dialog::backdrop { background: #17243c80; }
    .simulation-stage { display: grid; justify-items: center; gap: .8rem; padding: 1rem; border-radius: .5rem; background: #101923; color: #fff; text-align: center; }
    .simulation-stage h3 { margin: 0; max-width: 100%; line-height: 1.2; overflow-wrap: anywhere; white-space: pre-wrap; }
    .simulation-stage .plan { cursor: default; }
    .simulation-stage .plan > img { max-height: 58vh; margin: auto; }
    .simulation-stage.image-only .plan { width: 100%; }
    .simulation-stage.image-only .plan > img { width: 100%; height: 64vh; max-height: none; object-fit: contain; }
</style>
}

<div class="workspace">
    <aside aria-label="測點頁面與共用平面圖" tabindex="0">
        <a class="action" href="/engineering?add=true">＋ 新增測點頁面</a>
        <h2>測點頁面</h2>
        @if (Model.Plans.Length == 0)
        {
            <p class="muted">尚未建立測點頁面</p>
        }
        <ul>
        @foreach (WebAccess.Media.PointPlan plan in Model.Plans)
        {
            <li><a asp-page="Points" asp-route-selected="@plan.Point" aria-current="@(Model.Selected?.Point == plan.Point ? "page" : null)">@plan.Point</a></li>
        }
        </ul>
        <h2>共用平面圖</h2>
        <p class="muted">一次上傳多張底圖，供各測點頁面選用。</p>
        <form id="floor-upload" method="post" asp-page-handler="UploadFloorImages" enctype="multipart/form-data">
            <label>選取底圖即上傳 <input id="floor-upload-input" name="images" type="file" multiple accept=".png,.jpg,.jpeg"></label>
        </form>
        <p id="floor-status" class="feedback" role="status"></p>
        <p class="muted" id="floor-count">@Model.FloorImages.Length 張圖可供測點選用</p>
        <div class="floor-grid" id="floor-grid">
            @foreach (WebAccess.Media.FloorImage floor in Model.FloorImages)
            {
                <div class="floor-entry">
                    <button class="floor-card" type="button" data-floor="@floor.File" title="@floor.Name">
                        <img src="/engineering-media/@floor.File" alt="" loading="lazy"><span>@floor.Name</span>
                    </button>
                    <button class="floor-delete" type="button" data-delete="@floor.File" aria-label="刪除 @floor.Name">刪除</button>
                </div>
            }
        </div>
    </aside>
    <main>
        <div class="workspace-title">
            <h1>@(Model.Selected?.Point ?? "新增測點頁面")</h1>
            <button id="open-simulation" type="button" aria-haspopup="dialog" disabled="@(Model.Selected is null)">模擬警報預覽</button>
        </div>
        @if (Model.Feedback is string feedback)
        {
            <p class="feedback" role="status">@feedback</p>
        }
        <div class="editor">
            <div class="canvas card">
                <p id="empty-plan" class="muted" hidden="@(Model.Selected is not null)">上傳平面圖後，點選圖面設定告警位置。</p>
                <div id="alarm-preview-group" hidden="@(Model.Selected is null)">
                <h2 id="alarm-preview" data-api-text="@Model.CurrentAlarmText"></h2>
                <div class="plan" id="plan">
                    @if (Model.Selected is WebAccess.Media.PointPlan selected)
                    {
                        <img id="image" src="/engineering-media/@selected.File" alt="測點平面圖">
                    }
                    else
                    {
                        <img id="image" alt="測點平面圖預覽">
                    }
                    <span class="marker alarm-icon" id="marker" data-icon="@(Model.Selected?.Icon ?? "dot")" style="left:@(initialX)%;top:@(initialY)%">
                        <img id="marker-image" alt="" hidden>
                    </span>
                </div>
                </div>
            </div>
            <div class="inspector card" role="region" aria-labelledby="inspector-title" tabindex="0">
                <h2 id="inspector-title">測點與告警位置</h2>
                <form method="post" asp-page-handler="Save" enctype="multipart/form-data">
                    <input id="point-revision" name="revision" type="hidden" value="@Model.Revision">
                    <input name="isNew" type="hidden" value="@(Model.Selected is null ? "true" : "false")">
                    <label>測點 Name <input id="point-name" name="point" value="@Model.Selected?.Point" required maxlength="256" readonly="@(Model.Selected is not null)"></label>
                    @if (Model.Selected is null)
                    {
                        <p><button type="button" id="load-tags" aria-haspopup="dialog">從 WebAccess 選取測點</button></p>
                    }
                    <label>共用底圖
                        <select name="sharedFile" id="shared-file">
                            <option value="">@(Model.Selected is null ? "請選擇底圖" : "沿用目前底圖")</option>
                            @foreach (WebAccess.Media.FloorImage floor in Model.FloorImages)
                            {
                                <option value="@floor.File">@floor.Name</option>
                            }
                        </select>
                    </label>
                    <label>或上傳新底圖 <input name="image" id="file" type="file" accept=".png,.jpg,.jpeg"></label>
                    <fieldset>
                        <legend>警報文字</legend>
                        <input type="hidden" name="suggestedAlarmText" id="suggested-alarm-text">
                        <label>自訂文字
                            <textarea name="alarmText" id="alarm-text" rows="2" maxlength="500" placeholder="留空時使用 WebAccess 回傳的警報文字">@Model.Selected?.AlarmText</textarea>
                            <small>預設帶入測點描述。修改後才會覆寫 API 警報文字。</small>
                        </label>
                        <label>文字大小（px）
                            <input name="alarmTextSize" id="alarm-text-size" type="number" required
                                   min="@WebAccess.Media.PointPlan.MinAlarmTextSize" max="@WebAccess.Media.PointPlan.MaxAlarmTextSize"
                                   value="@(Model.Selected?.AlarmTextSize ?? WebAccess.Media.PointPlan.DefaultAlarmTextSize)">
                        </label>
                    </fieldset>
                    <div class="coordinates">
                        <label>水平位置 % <input id="x" name="x" type="number" min="0" max="100" value="@initialX" required></label>
                        <label>垂直位置 % <input id="y" name="y" type="number" min="0" max="100" value="@initialY" required></label>
                    </div>
                    <fieldset>
                        <legend>圖示樣式</legend>
                        <label>圖示大小（px）
                            <input name="iconSize" id="icon-size" type="number" required
                                   min="@WebAccess.Media.PointPlan.MinIconSize" max="@WebAccess.Media.PointPlan.MaxIconSize"
                                   value="@(Model.Selected?.IconSize ?? WebAccess.Media.PointPlan.DefaultIconSize)">
                        </label>
                        <div class="icon-grid">
                            @foreach ((string value, string label) in WebAccess.Media.Pages.PointsModel.AlarmIcons)
                            {
                                <label class="icon-option">
                                    <input type="radio" name="icon" value="@value" checked="@((Model.Selected?.Icon ?? "dot") == value)">
                                    @if (value != "custom")
                                    {
                                        <span class="alarm-icon" data-icon="@value" aria-hidden="true"></span>
                                    }
                                    @label
                                </label>
                            }
                        </div>
                        <label id="custom-icon-field" hidden="@(Model.Selected?.Icon != "custom")">上傳 PNG / JPEG 圖示
                            <input name="customIcon" id="custom-icon" type="file" accept=".png,.jpg,.jpeg" data-existing="@Model.Selected?.IconFile">
                        </label>
                        <label class="check"><input type="checkbox" name="flash" id="flash" value="true" checked="@(Model.Selected?.Flash ?? true)">閃爍警報圖示</label>
                        <label class="check"><input type="checkbox" name="imageOnly" id="image-only" value="true" checked="@(Model.Selected?.ImageOnly ?? false)">全頁只顯示圖片</label>
                    </fieldset>
                    <button id="save-point" class="primary" type="submit">儲存設定</button>
                </form>
                @if (Model.Selected is WebAccess.Media.PointPlan current)
                {
                    <form class="remove" method="post" asp-page-handler="Remove"><button name="point" value="@current.Point">移除測點頁面</button></form>
                }
            </div>
        </div>
    </main>
</div>
<dialog class="simulation-dialog card" id="alarm-simulation" aria-labelledby="simulation-heading">
    <form method="dialog" class="simulation-toolbar">
        <h2 id="simulation-heading">模擬警報預覽</h2>
        <button>關閉</button>
    </form>
    <div class="simulation-stage" id="simulation-stage">
        <h3 id="simulation-text"></h3>
        <div class="plan" id="simulation-plan"><img id="simulation-image" alt="測點平面圖"></div>
    </div>
</dialog>
<template id="floor-entry">
    <div class="floor-entry">
        <button class="floor-card" type="button"><img alt="" loading="lazy"><span></span></button>
        <button class="floor-delete" type="button">刪除</button>
    </div>
</template>
@if (Model.Selected is null)
{
    <dialog class="tag-picker card" id="tag-picker" aria-labelledby="tag-picker-title">
        <div class="tag-picker-header">
            <h2 id="tag-picker-title">選取 WebAccess 測點</h2>
            <form method="dialog"><button>關閉</button></form>
        </div>
        <label>搜尋測點
            <input id="tag-search" type="search" placeholder="輸入 Name 或描述" autocomplete="off" autofocus>
        </label>
        <p class="muted" id="tag-status" role="status"></p>
        <button type="button" id="retry-tags" hidden>重新讀取</button>
        <div class="tag-results" id="tag-results" role="group" aria-label="搜尋結果"></div>
    </dialog>
}
<script>
const image = document.getElementById('image');
const previewGroup = document.getElementById('alarm-preview-group');
const previewText = document.getElementById('alarm-preview');
const alarmText = document.getElementById('alarm-text');
const suggestedText = document.getElementById('suggested-alarm-text');
const point = document.getElementById('point-name');
const alarmTextSize = document.getElementById('alarm-text-size');
const iconSize = document.getElementById('icon-size');
const marker = document.getElementById('marker');
const planFrame = document.getElementById('plan');
const openSimulation = document.getElementById('open-simulation');
const simulation = document.getElementById('alarm-simulation');
const simulationPlan = document.getElementById('simulation-plan');
const simulationImage = document.getElementById('simulation-image');
const markerImage = document.getElementById('marker-image');
const customIcon = document.getElementById('custom-icon');
const imageOnly = document.getElementById('image-only');
const x = document.getElementById('x');
const y = document.getElementById('y');
let temporaryImage = null;
let temporaryIcon = null;
function previewSize(field) {
    return Math.max(Number(field.min), Math.min(Number(field.max), Number(field.value || field.defaultValue))) + 'px';
}
function updateText() {
    previewText.textContent = alarmText.value.trim() || previewText.dataset.apiText || 'WebAccess 警報文字';
    previewText.style.fontSize = previewSize(alarmTextSize);
    previewText.hidden = imageOnly.checked;
}
function suggestText(description) {
    if (alarmText.value !== suggestedText.value) return;
    suggestedText.value = (description || '').trim().slice(0, alarmText.maxLength);
    alarmText.value = suggestedText.value;
    updateText();
}
async function loadSuggestedText() {
    const name = point.value.trim();
    if (!name || alarmText.value !== suggestedText.value) return;
    try {
        const response = await fetch('/engineering?handler=Tags&point=' + encodeURIComponent(name), { cache: 'no-store' });
        if (!response.ok || point.value.trim() !== name) return;
        const tag = await response.json();
        if (point.value.trim() === name) suggestText(tag.description);
    } catch {
        // 讀取測點失敗時保留可手動輸入的文字。
    }
}
if (previewText.dataset.apiText) suggestText(previewText.dataset.apiText);
else if (point.readOnly) loadSuggestedText();
point.addEventListener('change', () => {
    suggestText('');
    loadSuggestedText();
});
function updateIcon() {
    const icon = document.querySelector('input[name=icon]:checked').value;
    const isCustom = icon === 'custom';
    marker.dataset.icon = icon;
    marker.dataset.flash = document.getElementById('flash').checked;
    marker.style.setProperty('--icon-size', previewSize(iconSize));
    marker.hidden = imageOnly.checked;
    planFrame.classList.toggle('alarm-frame', !marker.hidden);
    updateText();
    document.getElementById('custom-icon-field').hidden = !isCustom;
    customIcon.disabled = !isCustom;
    customIcon.required = isCustom && !customIcon.dataset.existing;
    const source = temporaryIcon || (customIcon.dataset.existing ? '/engineering-media/' + customIcon.dataset.existing : '');
    markerImage.hidden = !isCustom || !source;
    if (source && markerImage.getAttribute('src') !== source) markerImage.src = source;
}
alarmText.addEventListener('input', updateText);
alarmTextSize.addEventListener('input', updateText);
iconSize.addEventListener('input', updateIcon);
for (const field of document.querySelectorAll('input[name=icon], #flash, #image-only')) {
    field.addEventListener('change', updateIcon);
}
customIcon.addEventListener('change', () => {
    if (temporaryIcon) URL.revokeObjectURL(temporaryIcon);
    temporaryIcon = customIcon.files[0] ? URL.createObjectURL(customIcon.files[0]) : null;
    updateIcon();
});
updateIcon();
openSimulation.addEventListener('click', () => {
    const source = image.getAttribute('src');
    if (!source) return;
    const text = document.getElementById('simulation-text');
    text.textContent = previewText.textContent;
    text.style.fontSize = previewText.style.fontSize;
    text.hidden = imageOnly.checked;
    document.getElementById('simulation-stage').classList.toggle('image-only', imageOnly.checked);
    simulationPlan.classList.toggle('alarm-frame', !marker.hidden);
    simulationImage.src = source;
    if (!marker.hidden) {
        const icon = marker.cloneNode(true);
        icon.removeAttribute('id');
        icon.querySelector('img').removeAttribute('id');
        simulationPlan.append(icon);
    }
    simulation.showModal();
});
simulation.addEventListener('close', () => {
    simulationImage.removeAttribute('src');
    simulationPlan.querySelector('.marker')?.remove();
});
function updateMarker() {
    marker.style.left = x.value + '%';
    marker.style.top = y.value + '%';
}
x.addEventListener('input', updateMarker);
y.addEventListener('input', updateMarker);
function locate(event) {
    const bounds = image.getBoundingClientRect();
    if (!bounds.width || !bounds.height) return;
    x.value = Math.max(0, Math.min(100, Math.round(100 * (event.clientX - bounds.left) / bounds.width)));
    y.value = Math.max(0, Math.min(100, Math.round(100 * (event.clientY - bounds.top) / bounds.height)));
    updateMarker();
}
image.addEventListener('click', locate);
marker.addEventListener('pointerdown', event => {
    if (event.button !== 0) return;
    marker.setPointerCapture(event.pointerId);
});
marker.addEventListener('pointermove', event => {
    if (marker.hasPointerCapture(event.pointerId)) locate(event);
});
const loadTags = document.getElementById('load-tags');
if (loadTags) {
    const dialog = document.getElementById('tag-picker');
    const search = document.getElementById('tag-search');
    const message = document.getElementById('tag-status');
    const results = document.getElementById('tag-results');
    const retry = document.getElementById('retry-tags');
    const limit = 100;
    let tags = null;
    let loading = false;
    let selected = false;
    function renderTags() {
        if (!tags) return;
        const words = search.value.trim().toLocaleLowerCase().split(/\s+/).filter(Boolean);
        const matches = tags.filter(tag => words.every(word => tag.searchText.includes(word)));
        results.replaceChildren();
        for (const tag of matches.slice(0, limit)) {
            const button = document.createElement('button');
            const name = document.createElement('strong');
            const description = document.createElement('small');
            button.type = 'button';
            button.className = 'tag-result';
            name.textContent = tag.name;
            description.textContent = tag.description;
            button.append(name, description);
            button.addEventListener('click', () => {
                point.value = tag.name;
                suggestText(tag.description);
                selected = true;
                dialog.close();
            });
            results.append(button);
        }
        message.textContent = !tags.length ? 'WebAccess 目前沒有測點。'
            : !matches.length ? '沒有符合的測點。請更換關鍵字，或關閉後手動輸入。'
            : matches.length > limit ? `找到 ${matches.length} 筆，顯示前 ${limit} 筆。可加入關鍵字縮小範圍。`
            : `找到 ${matches.length} 筆測點。`;
    }
    async function fetchTags() {
        if (loading) return;
        loading = true;
        retry.hidden = true;
        results.replaceChildren();
        message.textContent = '正在讀取測點…';
        try {
            const response = await fetch('/engineering?handler=Tags', { cache: 'no-store' });
            const data = await response.json();
            if (!response.ok) throw new Error(data.error);
            tags = data.map(tag => ({ ...tag, searchText: (tag.name + ' ' + tag.description).toLocaleLowerCase() }));
            renderTags();
        } catch (error) {
            message.textContent = error.message || '無法讀取測點，請手動輸入。';
            retry.hidden = false;
        } finally {
            loading = false;
        }
    }
    loadTags.addEventListener('click', () => {
        selected = false;
        search.value = '';
        dialog.showModal();
        if (tags) renderTags();
        else fetchTags();
    });
    dialog.addEventListener('close', () => {
        if (selected) point.focus();
    });
    retry.addEventListener('click', () => {
        search.focus();
        fetchTags();
    });
    search.addEventListener('input', renderTags);
    dialog.addEventListener('keydown', event => {
        if (event.isComposing || event.keyCode === 229) return;
        const first = results.firstElementChild;
        if (event.target === search && first && (event.key === 'ArrowDown' || event.key === 'Enter')) {
            event.preventDefault();
            if (event.key === 'Enter') first.click();
            else first.focus();
        } else if (results.contains(event.target) && ['ArrowUp', 'ArrowDown'].includes(event.key)) {
            event.preventDefault();
            const next = event.key === 'ArrowDown' ? event.target.nextElementSibling : event.target.previousElementSibling || search;
            next?.focus();
        }
    });
}
const fileInput = document.getElementById('file');
const sharedFile = document.getElementById('shared-file');
const originalImage = image.getAttribute('src');
function updatePlan() {
    const file = fileInput.files[0];
    if (temporaryImage) URL.revokeObjectURL(temporaryImage);
    temporaryImage = file ? URL.createObjectURL(file) : null;
    const source = temporaryImage || (sharedFile.value ? '/engineering-media/' + encodeURIComponent(sharedFile.value) : originalImage);
    if (source) image.src = source;
    else image.removeAttribute('src');
    previewGroup.hidden = !source;
    openSimulation.disabled = !source;
    document.getElementById('empty-plan').hidden = !!source;
}
fileInput.addEventListener('change', updatePlan);
sharedFile.addEventListener('change', () => {
    fileInput.value = '';
    updatePlan();
});
const grid = document.getElementById('floor-grid');
const libraryForm = document.getElementById('floor-upload');
const uploadInput = document.getElementById('floor-upload-input');
const libraryStatus = document.getElementById('floor-status');
const revision = document.getElementById('point-revision');
const savePoint = document.getElementById('save-point');
let libraryBusy = false;
function renderLibrary(images) {
    const selectedFile = sharedFile.value;
    sharedFile.replaceChildren(sharedFile.options[0]);
    grid.replaceChildren();
    for (const floor of images) {
        sharedFile.add(new Option(floor.name, floor.file));
        const entry = document.getElementById('floor-entry').content.cloneNode(true);
        const card = entry.querySelector('.floor-card');
        const remove = entry.querySelector('.floor-delete');
        card.dataset.floor = floor.file;
        card.title = floor.name;
        card.querySelector('img').src = '/engineering-media/' + encodeURIComponent(floor.file);
        card.querySelector('span').textContent = floor.name;
        remove.dataset.delete = floor.file;
        remove.setAttribute('aria-label', '刪除 ' + floor.name);
        grid.append(entry);
    }
    sharedFile.value = images.some(floor => floor.file === selectedFile) ? selectedFile : '';
    document.getElementById('floor-count').textContent = images.length + ' 張圖可供測點選用';
    updatePlan();
}
async function updateLibrary(endpoint, body, pending) {
    if (libraryBusy) return;
    libraryBusy = true;
    uploadInput.disabled = true;
    savePoint.disabled = true;
    libraryStatus.textContent = pending;
    try {
        body.set('revision', revision.value);
        const response = await fetch(endpoint, { method: 'POST', body });
        const result = await response.json();
        libraryStatus.textContent = result.message;
        if (response.ok) {
            revision.value = result.revision;
            renderLibrary(result.images);
        }
    } catch {
        libraryStatus.textContent = '圖庫操作未完成。請確認連線或檔案大小後再試。';
    } finally {
        libraryBusy = false;
        uploadInput.disabled = false;
        savePoint.disabled = false;
        uploadInput.value = '';
    }
}
uploadInput.addEventListener('change', () => {
    if (uploadInput.files.length) updateLibrary(libraryForm.action, new FormData(libraryForm), '正在上傳底圖…');
});
grid.addEventListener('click', event => {
    const card = event.target.closest('[data-floor]');
    if (card) {
        sharedFile.value = card.dataset.floor;
        fileInput.value = '';
        updatePlan();
        return;
    }
    const remove = event.target.closest('[data-delete]');
    if (!remove || libraryBusy) return;
    if (!window.confirm('確定要刪除這張共用平面圖？')) return;
    const body = new FormData(libraryForm);
    body.delete('images');
    body.set('file', remove.dataset.delete);
    updateLibrary('/engineering?handler=DeleteFloorImage', body, '正在刪除底圖…');
});
</script>
